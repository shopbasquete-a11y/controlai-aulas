# ============================================
# ControlAI - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env.local e preencha com seus valores reais
# NUNCA commite o arquivo .env.local no Git!

# ============================================
# Supabase Configuration
# ============================================
# Obtenha estes valores no Dashboard do Supabase: Settings > API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-key-aqui

# Chave service_role (NUNCA use no frontend - apenas em Edge Functions)
# Configure esta variável nas Secrets do Supabase (Dashboard > Edge Functions > Secrets)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# ============================================
# Stripe Configuration
# ============================================
# Obtenha no Dashboard do Stripe: Developers > API keys
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_... # Obtenha após criar webhook endpoint

# ============================================
# Brevo (E-mails Transacionais)
# ============================================
# Obtenha no Dashboard do Brevo: Settings > SMTP & API
# Configure esta variável nas Secrets do Supabase
BREVO_API_KEY=sua-brevo-api-key-aqui

# ============================================
# LLM APIs (Para Testes)
# ============================================
# Estas são apenas para testes locais
# Em produção, os clientes fornecerão suas próprias chaves (BYOK)
OPENAI_API_KEY=sk-test-... # Opcional para testes
ANTHROPIC_API_KEY=sk-ant-... # Opcional para testes

# ============================================
# Ambiente
# ============================================
NODE_ENV=development

